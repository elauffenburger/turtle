{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "(lldb) Debug Builder",
      "type": "lldb",
      "request": "launch",
      "program": "${input:detectedBuildProgramDir}",
      "args": ["/opt/homebrew/bin/zig", ".", "zig-cache", "zig-cache"],
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "(lldb) Launch",
      "cwd": "${workspaceFolder}",
      "type": "lldb",
      "request": "launch",
      "args": [
        "-c",
        "echo $(echo a)$(echo b)"
      ],
      "program": "${workspaceFolder}/zig-out/bin/turtle",
      "preLaunchTask": "build"
    },
    {
      "name": "(lldb) attach",
      "type": "lldb",
      "request": "attach",
      "pid": "${command:pickProcess}",
      "program": "${workspaceFolder}/zig-out/bin/turtle",
    }
  ],
  "inputs": [
    {
      "id": "detectedBuildProgramDir",
      "type": "command",
      "command": "shellCommand.execute",
      "args": {
        "command": "find ${workspaceFolder} -type file -name build | head -n 1"
      }
    }
  ]
}
